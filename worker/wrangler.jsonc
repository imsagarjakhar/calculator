{
  "name": "intimetec-vlogs",
  "main": "index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://intimetec.org",
    "ADMIN_USERNAME": "imsagarjakhar",
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "7696231",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "7696232",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
