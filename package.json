{
  "name": "intimetec-money-planner",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs && node scripts/secure-build.cjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node scripts/test.cjs && npm run test:vlogs && npm run test:budget && npm run test:loans",
    "test:loans": "node --experimental-strip-types --test scripts/loans.test.mjs",
    "test:budget": "node --experimental-strip-types --test scripts/budget.test.mjs",
    "test:vlogs": "node --test scripts/vlog-worker.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
